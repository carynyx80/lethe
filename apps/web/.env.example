# Which network the app talks to: 99801 = Elysium testnet, 31337 = local anvil.
NEXT_PUBLIC_CHAIN_ID=
# LetheAuction address from contracts/deployments/<chainId>.json (set only after a verified deployment).
NEXT_PUBLIC_AUCTION_ADDRESS=
# Optional RPC override (must be safe to expose publicly). Defaults to the chain's public RPC.
NEXT_PUBLIC_RPC_URL=
# Optional: enables WalletConnect (mobile QR) in the connect dialog.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
